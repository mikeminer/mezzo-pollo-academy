{
  "name": "mezzopollo-academy",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wallet": "node scripts/build-wallet.mjs",
    "build:transaction": "node scripts/build-transaction.mjs",
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "check:locales": "node scripts/build-locales.mjs --check",
    "postinstall": "node scripts/build-monthly-server.mjs"
  },
  "dependencies": {
    "@cherrydotfun/miniapp-sdk": "0.1.24",
    "@neondatabase/serverless": "1.0.2",
    "@pump-fun/pump-sdk": "4.3.1",
    "@solana-mobile/mobile-wallet-adapter-protocol": "3.0.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "overrides": {
    "@solana/web3.js": {
      "rpc-websockets": "9.3.6"
    }
  }
}
