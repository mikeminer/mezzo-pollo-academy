{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-public.mjs",
  "outputDirectory": ".web-output",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/practice",
      "destination": "/play"
    },
    {
      "source": "/.well-known/cherry-app.json",
      "destination": "/api/cherry-proof"
    }
  ],
  "headers": [
    {
      "source": "/cherry",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://chat.cherry.fun https://cherry.fun https://*.cherry.fun"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/cherry",
      "permanent": false
    }
  ]
}
